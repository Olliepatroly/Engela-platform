# Engela Health — Clinical Platform (engelahealth.com)
# Copy to .env.local for local dev. NEVER commit real secrets.
# In production these live in Cloudflare Worker secrets + GitHub Actions secrets.

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://engelahealth.com
NEXT_PUBLIC_MARKETING_URL=https://engelahealth.co.uk
# production | preview | development
NEXT_PUBLIC_ENVIRONMENT=development

# ── Supabase (SEPARATE project from the marketing site, EU/London region) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the browser, NEVER prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# For verifying JWTs / reading role claims server-side (optional in Phase 0)
SUPABASE_JWT_SECRET=

# ── Resend — transactional email for invites (wired in Phase 2) ──────
RESEND_API_KEY=
RESEND_FROM_EMAIL=team@engelahealth.com
# New create-account requests are routed here for approval (delivery needs RESEND_API_KEY)
ACCOUNT_REQUEST_APPROVER_EMAIL=oliver@engelaras.co.uk
